<?xml version="1.0" encoding="UTF-8" ?>

<arquillian xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xmlns="http://jboss.org/schema/arquillian"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">
    <container qualifier="wildfly-managed" default="true">
        <configuration>
            <property name="jbossHome">${jboss.dir}</property>
            <!--
            <property name="javaHome">/usr/lib/jvm/java-21-openjdk</property>
            -->
            <property name="serverConfig">standalone-full.xml</property>
            <property name="javaVmArguments">-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005 -Djava.net.preferIPv4Stack=true</property>
        </configuration>
    </container>
    <extension qualifier="suite">
        <property name="deploymentClass">com.buschmais.training.jee.it.Deployments</property>
    </extension>
</arquillian>
